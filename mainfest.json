{
  "manifest_version": 3,
  "name": "ZK Password Manager Autofill",
  "version": "1.0.0",
  "description": "Autofill passwords from your Zero-Knowledge vault.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost:5001/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
